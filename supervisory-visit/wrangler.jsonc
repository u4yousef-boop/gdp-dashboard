{
  "$schema": "https://schemas.cloudflare.com/wrangler/config-schema.json",
  "name": "istimara-ziyara-ishrafiya",
  "main": "src/index.js",
  "compatibility_date": "2026-10-12",
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}


